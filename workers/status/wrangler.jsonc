{
  // ourea-docs-status: probes the anonymous API every 5 minutes and keeps
  // 24 hours of results in KV (one write per run: 288 a day, inside the
  // free tier's 1,000). It has no hostname: the docs Worker forwards
  // /status/data.json and /status/badge.svg to it through a service binding
  // (see ../../wrangler.jsonc), so deploy this Worker first.
  //
  // Before the first deploy, create the KV namespace and put its id below:
  //   npx wrangler kv namespace create ourea-docs-status
  // Deploy (not from CI): npx wrangler deploy -c workers/status/wrangler.jsonc
  // Local: npx wrangler dev -c workers/status/wrangler.jsonc --test-scheduled
  //   then GET http://localhost:8787/__scheduled?cron=*/5+*+*+*+* runs one probe.
  "name": "ourea-docs-status",
  "main": "index.mjs",
  "compatibility_date": "2026-06-29",
  "workers_dev": false,
  "triggers": { "crons": ["*/5 * * * *"] },
  "kv_namespaces": [
    // The id is filled in at deploy time; any string works for wrangler dev.
    { "binding": "STATUS", "id": "0717bec78b574ab0b46dff79f836cc2b" }
  ]
}
