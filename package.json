{
  "name": "ourea-docs",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "license": "BSD-2-Clause",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check:seo": "node scripts/check-seo.mjs dist",
    "check:examples": "node scripts/check-examples.mjs",
    "test:curl": "node scripts/run-curl-examples.mjs",
    "test:http": "node scripts/run-http-examples.mjs",
    "test:capnp": "node scripts/run-capnp-examples.mjs",
    "mock": "node scripts/mock-server.mjs --port 8787",
    "sync:spec": "node scripts/sync-spec.mjs",
    "sync:examples": "node scripts/sync-examples.mjs",
    "gate": "npm run build && npm run test:unit && npm run check:seo && node scripts/check-reference.mjs dist && node scripts/sync-spec.mjs --check && node scripts/sync-schema.mjs --check && node scripts/check-examples.mjs",
    "sync:schema": "node scripts/sync-schema.mjs",
    "check:reference": "node scripts/check-reference.mjs dist",
    "test:unit": "node --test 'tests/*.test.mjs'"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.6",
    "@scalar/api-reference": "1.73.1",
    "astro": "7.3.8",
    "sharp": "0.35.5",
    "starlight-links-validator": "0.27.0",
    "yaml": "2.9.1"
  },
  "description": "docs.oureawx.com: developer docs for the Ourea probabilistic weather API",
  "overrides": {
    "@scalar/json-magic": {
      "undici": "7.30.1"
    },
    "@ai-sdk/provider-utils": "4.0.33"
  }
}
