{
  // docs.oureawx.com: the Astro/Starlight static build, served from ./dist by
  // Workers static assets, plus one small Worker script for /mcp (the docs
  // MCP server, workers/docs/). Every other path is a static file and never
  // runs the script.
  //
  // The only public hostname is docs.oureawx.com, attached as a Worker Custom
  // Domain by Terraform in the private ourea repository
  // (terraform/cloudflare_docs.tf), not here. /mcp is a path on that same
  // hostname, so it needs no extra route.
  // workers_dev stays off so no *.workers.dev copy of the site exists.
  //
  // Deploy (not from CI): npm ci && npm run build && npx wrangler deploy
  // Local: npm run build && npx wrangler dev (http://localhost:8787/mcp)
  "name": "ourea-docs",
  "main": "workers/docs/index.mjs",
  "compatibility_date": "2026-06-29",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only /mcp runs the script first; everything else is served as a file.
    "run_worker_first": ["/mcp", "/mcp/"],
    // Static site: a missing path is a real 404 (dist/404.html), never
    // index.html, so a missing hashed asset can't be cached as HTML.
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
}
