{
  "name": "credentials/open-routes-keyless",
  "description": "With a key configured, search, catalog detail and attribution are sent WITHOUT X-API-Key (edge-cacheable); catalog list pages and forecasts keep it.",
  "client": {
    "api_key": "ow_pro"
  },
  "calls": [
    {
      "operation": "searchLocations",
      "args": {
        "q": "hood"
      }
    },
    {
      "operation": "getCatalogLocation",
      "args": {
        "slug": "mt-hood-meadows"
      }
    },
    {
      "operation": "getAttribution",
      "args": {}
    },
    {
      "operation": "listCatalogLocations",
      "args": {}
    },
    {
      "operation": "getLocationForecast",
      "args": {
        "state": "or",
        "name": "mt-hood-meadows"
      }
    }
  ],
  "expect_requests": [
    {
      "method": "GET",
      "path": "/api/v1/search/locations",
      "headers_absent": [
        "X-API-Key"
      ]
    },
    {
      "method": "GET",
      "path": "/api/v1/catalog/locations/mt-hood-meadows",
      "headers_absent": [
        "X-API-Key"
      ]
    },
    {
      "method": "GET",
      "path": "/api/v1/attribution",
      "headers_absent": [
        "X-API-Key"
      ]
    },
    {
      "method": "GET",
      "path": "/api/v1/catalog/locations",
      "headers": {
        "X-API-Key": "ow_pro"
      }
    },
    {
      "method": "GET",
      "path": "/api/v1/locations/or/mt-hood-meadows",
      "headers": {
        "X-API-Key": "ow_pro"
      }
    }
  ],
  "responses": [
    {
      "status": 200,
      "headers": {
        "Content-Type": "application/json"
      },
      "body_file": "bodies/search.json"
    },
    {
      "status": 200,
      "headers": {
        "Content-Type": "application/json"
      },
      "body_file": "bodies/catalog-detail.json"
    },
    {
      "status": 200,
      "headers": {
        "Content-Type": "application/json"
      },
      "body_file": "bodies/attribution.json"
    },
    {
      "status": 200,
      "headers": {
        "Content-Type": "application/json"
      },
      "body_file": "bodies/catalog-page-2.json"
    },
    {
      "status": 200,
      "headers": {
        "Content-Type": "application/json"
      },
      "body_file": "bodies/forecast-metric.json"
    }
  ],
  "expect": {
    "requests": 5
  }
}
