{
  "name": "credentials/send-key-everywhere-option",
  "description": "send_key_on_open_routes = true sends the key on open routes too.",
  "client": {
    "api_key": "ow_pro",
    "send_key_on_open_routes": true
  },
  "call": {
    "operation": "searchLocations",
    "args": {
      "q": "hood"
    }
  },
  "expect_request": {
    "method": "GET",
    "path": "/api/v1/search/locations",
    "headers": {
      "X-API-Key": "ow_pro"
