{
  "name": "retry/429-retry-after-too-long",
  "description": "Retry-After over 60 s is not waited out: the error is returned with retry_after set.",
  "client": {},
  "call": {
    "operation": "getLocationForecast",
    "args": {
      "state": "or",
      "slug": "mt-hood-meadows"
    }
  },
  "expect_request": {
    "method": "GET"
  },
  "responses": [
    {
      "status": 429,
      "headers": {
        "Content-Type": "application/json",
        "Retry-After": "3600"
      },
      "body_file": "bodies/error-rate-limited.json"
    }
  ],
  "expect": {
    "error": {
      "category": "rate_limited",
      "code": "TOO_MANY_REQUESTS",
      "status": 429,
      "retry_after": 3600
    },
    "requests": 1,
    "delays_s": []
  }
}
